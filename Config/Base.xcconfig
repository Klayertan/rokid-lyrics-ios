SWIFT_VERSION = 6.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1

// Clone-buildable defaults. Developer-owned values belong in the optional,
// gitignored Local.xcconfig included below.
ROKID_LYRICS_DEVELOPMENT_TEAM =
ROKID_LYRICS_BUNDLE_ID = com.rokidlyrics.app
ROKID_LYRICS_SHARE_BUNDLE_ID = $(ROKID_LYRICS_BUNDLE_ID).ShareExtension
ROKID_LYRICS_APP_GROUP = group.com.rokidlyrics.shared
ROKID_LYRICS_BUILD_MODE = mock
ROKID_LYRICS_DEFAULT_MOCK_MODE = YES
ROKID_SDK_AVAILABLE = NO
ROKID_LYRICS_SDK_COMPILATION_CONDITION =

// Personal Team / free Apple ID development mode. Mock and Hardware configs
// leave these at their full-capability defaults; only Personal.xcconfig
// overrides them. See docs/PERSONAL_TEAM_MODE.md.
ROKID_LYRICS_PERSONAL_TEAM_MODE = NO
ROKID_LYRICS_SHARE_EXTENSION_AVAILABLE = YES
ROKID_LYRICS_APP_GROUP_AVAILABLE = YES

// ShazamKit compiles and links without any entitlement in this project (see
// docs/PERSONAL_TEAM_MODE.md), so it defaults to available everywhere. The
// indirection mirrors ROKID_LYRICS_SDK_COMPILATION_CONDITION: set this to
// empty in a gitignored Local.xcconfig to compile a build without it.
ROKID_LYRICS_SHAZAM_AVAILABLE = YES
ROKID_LYRICS_SHAZAM_COMPILATION_CONDITION = ROKID_LYRICS_SHAZAM_AVAILABLE

ENABLE_USER_SCRIPT_SANDBOXING = YES
CLANG_ENABLE_MODULES = YES

// Optional developer-local signing, identifiers, and hardware settings.
// This file is gitignored; start from Local.xcconfig.example.
#include? "Local.xcconfig"

// Indirection lets the dedicated Mock configurations remove the proprietary
// SDK condition even when Local.xcconfig enables hardware development.
SWIFT_ACTIVE_COMPILATION_CONDITIONS = $(inherited) $(ROKID_LYRICS_SDK_COMPILATION_CONDITION) $(ROKID_LYRICS_SHAZAM_COMPILATION_CONDITION)
