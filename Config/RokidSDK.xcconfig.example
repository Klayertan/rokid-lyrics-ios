// Legacy/advanced hardware override snippet. New setups should copy
// Local.xcconfig.example to Local.xcconfig and use the `Rokid Lyrics Hardware`
// scheme, which applies these values without affecting Mock or CI builds.
ROKID_SDK_AVAILABLE = YES
ROKID_LYRICS_SDK_COMPILATION_CONDITION = ROKID_SDK_AVAILABLE
ROKID_LYRICS_BUILD_MODE = rokid-hardware
ROKID_LYRICS_DEFAULT_MOCK_MODE = NO
